# Postgres. Matches docker-compose.yml for local development.
DATABASE_URI="postgres://portfolio:portfolio@localhost:5433/portfolio"

# Payload signing secret. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=""

# Public site origin, used for metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible). Leave empty to store uploads on disk locally.
# Endpoint:   https://<account-id>.r2.cloudflarestorage.com  (no bucket suffix)
# Media host: the bucket's public domain, pub-<id>.r2.dev or a custom domain,
#             with public access enabled in the bucket settings.
# Keys come from R2 > Manage API Tokens (Object Read & Write, scoped to the
# bucket). The secret is shown once.
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Host that serves the bucket publicly, for next/image remotePatterns.
NEXT_PUBLIC_MEDIA_HOST=""

# One-off Hygraph migration (Phase 4). Can be removed after the import.
HYGRAPH_URL=""
HYGRAPH_TOKEN=""

# Local docker compose
POSTGRES_PASSWORD="portfolio"
POSTGRES_HOST_PORT="5433"
